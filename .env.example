[TEMPLATE]
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://marketmind:marketmind@localhost:5432/marketmind

# ── Market Data Mode ──────────────────────────────────────────────────
# "simulated" – zero-config demo feed (default)
# "upstox"    – live NSE/BSE data via Upstox V3 WebSocket
#                Requires UPSTOX_ACCESS_TOKEN and upstox-python-sdk
MARKET_DATA_MODE=simulated

# ── Upstox V3 (live market data) ──────────────────────────────────────
# Get credentials at https://upstox.com/developer/api-registration
# Use a read-only analytics token (no order permissions needed)
UPSTOX_ACCESS_TOKEN=
# The following are needed only for the OAuth2 token generation flow:
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=

# ── Other data providers (optional) ────────────────────────────────────
FINNHUB_API_KEY=
NEWS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── AI Mentor (local LLM) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=60
